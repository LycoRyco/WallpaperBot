{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wallpaperbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "FXEMBED_API_BASE_URL": "https://api.fxtwitter.com"
  },
  "d1_databases": [
    {
      "binding": "WALLPAPERBOT_DB",
      "database_name": "wallpaperbot-db",
      "database_id": "498b82e1-3a59-4b4d-98f9-71df8c44b94d"
    }
  ]
}
