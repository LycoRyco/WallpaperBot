{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "your-wallpaperbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "FXEMBED_API_BASE_URL": "https://api.fxtwitter.com",
    "CHANNEL_HANDLE": "@YourWallpaperChannel"
  },
  "d1_databases": [
    {
      "binding": "WALLPAPERBOT_DB",
      "database_name": "your-wallpaperbot-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_UUID_HERE"
    }
  ]
}
